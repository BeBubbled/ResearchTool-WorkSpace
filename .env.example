# Copy this file to .env and fill in your own credentials. Do not commit .env.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# PDF 段落朗读（Azure Speech）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralus
AZURE_SPEECH_VOICE=zh-CN-YunxiNeural

# Markdown 图片发布（公开 GitHub 仓库）
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_IMAGE_ROOT=images
GITHUB_TOKEN=

# ResearchTool installs the latest stable Codex CLI under .runtime/codex by default.
# It checks once every 24 hours, keeps the previous release, and rolls back on startup failure.
# CODEX_UPDATE_INTERVAL_HOURS=24
# Optional advanced overrides; CODEX_BIN disables project-local management.
# CODEX_NPM_BIN=/absolute/path/to/npm
# CODEX_BIN=/absolute/path/to/codex
# The settings panel writes these after validating the account's live model list.
# CODEX_DEFAULT_MODEL=
# CODEX_REASONING_EFFORT=high
# Managed by the settings panel; omitted means medium length for all four phases.
# THREE_PASS_LENGTH_CONFIG=

# 双语改稿 · Google Cloud Translation – Basic (v2)。在 全局设置 → Google 翻译 中填写并验证。
# Cloud 控制台需启用 Cloud Translation API 并开通结算；每月前 50 万字符免费。
GOOGLE_TRANSLATE_API_KEY=

# 双语改稿 · Claude Code CLI 默认模型（全局设置 → Claude Code 写入；留空=推荐值）。
# CLAUDE_CODE_TRANSLATE_MODEL=sonnet
# CLAUDE_CODE_TRANSLATE_EFFORT=medium
# CLAUDE_CODE_REVISE_MODEL=opus
# CLAUDE_CODE_REVISE_EFFORT=high
# Optional: absolute path to the claude executable.
# CLAUDE_CODE_CLI=

# Optional: improves Semantic Scholar request isolation for Research Gap Map.
SEMANTIC_SCHOLAR_API_KEY=

# 演化树调研（/gap-survey）· OpenAlex 免费 Key：https://openalex.org/settings/api
# 在 全局设置 → OpenAlex 文献 中填写并验证；留空时按 IP 共用每天 0.10 美元的免费额度。
OPENALEX_API_KEY=
# 可选：OpenReview 匿名取审稿意见常被人机验证拦下。
# OPENREVIEW_TOKEN=

# Legacy single preset (shown as "默认 LLM" unless LLM_NAME is set).
LLM_NAME=DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_CONCURRENCY=1

# Optional named presets. List their identifiers in LLM_PRESETS, then set each
# group's display name, OpenAI-compatible base URL, API key, and model ID.
# LLM_PRESETS=deepseek,openai
# LLM_PRESET_DEEPSEEK_NAME=DeepSeek
# LLM_PRESET_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_PRESET_DEEPSEEK_API_KEY=
# LLM_PRESET_DEEPSEEK_MODEL=
# LLM_PRESET_DEEPSEEK_CONCURRENCY=1
# LLM_PRESET_OPENAI_NAME=OpenAI
# LLM_PRESET_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PRESET_OPENAI_API_KEY=
# LLM_PRESET_OPENAI_MODEL=
# LLM_PRESET_OPENAI_CONCURRENCY=1

# 数据存储目录（全局设置 → 数据存储 写入）：OCR/翻译结果、精读缓存、调研项目等运行成果放到这里，
# 例如 Google Drive 同步的文件夹。留空 = 项目 .runtime。修改后需重启面板。
# RESEARCHTOOL_DATA_DIR=
